{
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "sourceMap": true,
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    // Needed to avoid errors with vitest @types/chai dep, since it uses `{ default as chai }` on a CommonJS module
    // See https://github.com/vitest-dev/vitest/issues/1076
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/helpers"]
}
